# Anthropic API key used by the client-side prototype call in callClaude.js.
#
# WARNING: This is for prototype/development only. Shipping a build with a
# VITE_-prefixed key embeds the key in client bundles — anyone who loads the
# page can extract and reuse it. For any real deployment (especially to
# minors), this must be replaced by a backend proxy that holds the key
# server-side and applies per-user rate limiting, auth, and audit logging.
# See the README "Tech (Current vs. Designed)" table and the Roadmap.
VITE_ANTHROPIC_API_KEY=your-key-here
